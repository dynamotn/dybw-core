{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dybw-core/vectors/schema/scenario.schema.json",
  "title": "dybw-core generated scenario (encrypted); shares $defs with source.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"
    },
    "spec": {
      "const": "1.5"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^§[0-9]+(\\.[0-9]+)*$"
      }
    },
    "account": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "namespace": {
      "enum": [
        "bwss",
        "obsidian"
      ]
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "$ref": "source.schema.json#/$defs/options"
    },
    "local": {
      "$ref": "source.schema.json#/$defs/local"
    },
    "device": {
      "$ref": "source.schema.json#/$defs/device"
    },
    "ciphers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/serverCipher"
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "set-value"
            },
            "id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "fresh": {
              "$ref": "#/$defs/serverCipher"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "create"
            },
            "id": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "folderId": {
              "type": [
                "string",
                "null"
              ]
            },
            "fresh": {
              "$ref": "#/$defs/serverCipher"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "value",
            "folderId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "delete"
            },
            "id": {
              "type": "string"
            },
            "fresh": {
              "$ref": "#/$defs/serverCipher"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "expect": {
      "$ref": "source.schema.json#/$defs/expect"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "spec",
    "sections",
    "account",
    "namespace",
    "generator",
    "ciphers",
    "expect"
  ],
